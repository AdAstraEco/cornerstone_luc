# Keep the build context lean. See spike/Dockerfile.

# No git history in the runtime image: storage.py's cache key now uses func.__module__,
# not a git.Repo() lookup, so .git is no longer needed at runtime.
.git/

# The host venv must not shadow the image's uv-synced /app/.venv.
.venv/

# Local secrets: the image gets its .env from a mounted k8s Secret at runtime, not baked in.
.env

# Caches / build noise.
**/__pycache__/
*.pyc
.mypy_cache/
.pytest_cache/
.ruff_cache/
.cache/
.DS_Store
