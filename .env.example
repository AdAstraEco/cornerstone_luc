# EXPORT_ROOT is where the emissions COGs / mosaic VRTs land -- a terminal deliverable, a
# sibling to scratch (not a re-readable cache). Any fsspec URI, like the roots below.
# EXPORT_ROOT = '/absolute/path/to/emissions'
EXPORT_ROOT = 'gs://cornerstone-emissions-us-central1'
HARVARD_DATAVERSE_GUESTBOOK_JSON = '{"email":Replace with your email address,"institution":Replace with your institution}'
# INGEST_ROOT and SCRATCH_ROOT take any fsspec URI. A local root must be an absolute path
# that already exists; a gs:// root needs application-default credentials.
# INGEST_ROOT = '/absolute/path/to/ingest'
INGEST_ROOT = 'gs://cornerstone-ingest-us-central1'
NUMBER_OF_DASK_WORKERS = 12
# SCRATCH_ROOT = '/absolute/path/to/scratch'
SCRATCH_ROOT = 'gs://cornerstone-scratch-us-central1'
USDA_NASS_API_KEY = 'Replace me with value from https://quickstats.nass.usda.gov/api'

# --- Control plane (python -m controlplane) ------------------------------------------------------
# Settings for the Kubernetes job layer. A process environment variable of the same name overrides
# the value here. Non-secret identifiers only: cluster access comes from your gcloud login.
# See docs/control-plane/05-configuration-and-deployment.md.
CONTROLPLANE_GCP_PROJECT = 'my-project'
CONTROLPLANE_GCP_ZONE = 'us-central1-b'
CONTROLPLANE_GKE_CLUSTER = 'my-cluster'
# The only kubectl context allowed to write; the control plane refuses any other.
CONTROLPLANE_KUBE_CONTEXT = 'gke_my-project_us-central1-b_my-cluster'
CONTROLPLANE_NAMESPACE = 'my-namespace'
CONTROLPLANE_SERVICE_ACCOUNT = 'my-ksa'
# Secrets mounted as the pods' /app/.env: with and without the source-API keys.
CONTROLPLANE_SECRET = 'cornerstone-env'
CONTROLPLANE_SECRET_NOKEYS = 'cornerstone-env-nokeys'
CONTROLPLANE_IMAGE = 'us-central1-docker.pkg.dev/my-project/my-repo/cornerstone:latest'
# Heavy phases (compute) default to the first pool, the others to the second.
CONTROLPLANE_POOL_HEAVY = 'my-namespace-power-node-pool'
CONTROLPLANE_POOL_LIGHT = 'my-namespace-worker-node-pool'
# Optional: pools a run may use (default: exactly the two above).
# CONTROLPLANE_ALLOWED_POOL_REGEX = '^my-namespace-.*$'
CONTROLPLANE_BUCKET = 'my-bucket'
# Optional, with their defaults:
# CONTROLPLANE_DATA_PREFIX = 'cornerstone'
# CONTROLPLANE_MAX_PARALLELISM = 16
# CONTROLPLANE_MAX_TILES = 60
# CONTROLPLANE_CONFIRM_TILES = 20
