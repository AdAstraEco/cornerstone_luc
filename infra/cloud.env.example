# cornerstone cloud config template (docs/orbae/argo-workflows.md).
#
# The repo-root .env stays as-is for LOCAL runs. This is the separate CLOUD config: copy it
# to infra/cloud.env (gitignored), fill in real values, and create the k8s Secrets from it
# (see "One-off setup" in docs/orbae/argo-workflows.md). In-cluster, Config.from_dot_env
# reads this file at /app/.env, mounted from a Secret.

# fsspec URIs, under one prefix of the GCS bucket the pipeline writes to.
INGEST_ROOT = 'gs://YOUR-BUCKET/cornerstone/ingest'
SCRATCH_ROOT = 'gs://YOUR-BUCKET/cornerstone/scratch'
# The exported deliverables (COGs, mosaic VRTs) -- terminal outputs, a sibling to scratch.
EXPORT_ROOT = 'gs://YOUR-BUCKET/cornerstone/emissions'

# Inner per-pod Dask worker count -- keep it at or below the pod's CPU limit.
NUMBER_OF_DASK_WORKERS = 8

# Only the ingest steps use these. For the Secret the other steps mount, make
# infra/cloud-nokeys.env: a copy of this file with these two present but blank.
USDA_NASS_API_KEY = 'Replace with value from https://quickstats.nass.usda.gov/api'
HARVARD_DATAVERSE_GUESTBOOK_JSON = '{"email":"you@example.org","institution":"YourInstitution"}'
