# cornerstone cloud config template (docs/orbae/cornerstone-k8s.md).
#
# The repo-root .env stays as-is for LOCAL runs. This is the separate CLOUD config: copy it
# to infra/cloud.env (gitignored), fill in real values, and create the k8s Secret from it
# (see infra/k8s/README.md). In-cluster, Config.from_dot_env reads this file at /app/.env,
# mounted from that Secret.

# fsspec URIs. For the cornerstone these live under the cornerstone prefix of the dan bucket.
INGEST_ROOT = 'gs://YOUR-BUCKET/cornerstone/ingest'
SCRATCH_ROOT = 'gs://YOUR-BUCKET/cornerstone/scratch'

# Inner per-tile thread count -- matches the pod's CPU (e2-highmem-8, cpu limit 8).
NUMBER_OF_DASK_WORKERS = 8

# Only needed if pods run ingest. Prefer pre-ingesting once from a trusted host so the cache
# under INGEST_ROOT/SCRATCH_ROOT is warm and these can stay as placeholders on the workers.
USDA_NASS_API_KEY = 'Replace with value from https://quickstats.nass.usda.gov/api'
HARVARD_DATAVERSE_GUESTBOOK_JSON = '{"email":"you@example.org","institution":"YourInstitution"}'
