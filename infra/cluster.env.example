# cornerstone infra config template (docs/orbae/argo-workflows.md).
#
# Copy to infra/cluster.env (gitignored) and fill in real values, so that infra identifiers
# stay out of tracked files. Source it before running the build or argo/kubectl commands:
#   source infra/cluster.env

# The kube context for the cluster the Argo workflow runs on (through the GKE connect
# gateway). Every argo/kubectl command in the Argo doc passes --context "$KUBE_CONTEXT".
export KUBE_CONTEXT=your-kube-context

# The Artifact Registry repository the image is pushed to, WITHOUT a tag: images are tagged
# with the short SHA of the commit they were built from (see infra/Dockerfile).
export IMAGE=REGION-docker.pkg.dev/your-gcp-project/your-repo/cornerstone

# The GCP project the cluster, registry and bucket live in, for gcloud commands.
export GCP_PROJECT=your-gcp-project

# The GCS bucket that holds INGEST_ROOT, SCRATCH_ROOT and EXPORT_ROOT (set in infra/cloud.env),
# for inspecting outputs with `gcloud storage`.
export GCS_BUCKET=your-bucket
