# cornerstone infra config template (docs/orbae/cornerstone-k8s.md).
#
# Copy to infra/cluster.env (gitignored) and fill in your cluster's real values. Both the
# shell commands in infra/k8s/README.md and the Job submitter (infra/run-tiles.py) read
# these, so keep infra identifiers here rather than hard-coded in tracked files. Source it
# before running commands:  source infra/cluster.env

# GCP / GKE
export GCP_PROJECT=your-gcp-project
export GCP_ZONE=us-central1-b
export GKE_CLUSTER=your-cluster
export KUBE_CONTEXT=gke_your-gcp-project_us-central1-b_your-cluster

# Kubernetes objects (all namespace-scoped)
export K8S_NAMESPACE=your-namespace
export K8S_SERVICE_ACCOUNT=your-ksa       # Workload-Identity-bound KSA with GCS access
export K8S_SECRET=cornerstone-env               # holds the mounted cloud .env (infra/cloud.env)
export NODE_POOL=your-node-pool           # highmem pool the tile pods land on

# Artifact Registry image (built by infra/Dockerfile)
export IMAGE=REGION-docker.pkg.dev/your-gcp-project/your-repo/cornerstone:latest

# GCS bucket whose cornerstone/ prefix holds INGEST_ROOT + SCRATCH_ROOT (see infra/cloud.env)
export GCS_BUCKET=your-bucket
